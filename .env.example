# tapswarm 設定 — 仕様書 §11
# すべて環境変数で与える。設定ファイルは必須にしない。

# --- 必須 ---
# トークン署名鍵（256bit 以上）。アプリ開発者には見せない。
SIGNING_KEY=change-me-to-a-random-32-byte-or-longer-secret
# client_hash / ip_hash 用の鍵。ソースコードやリポジトリに含めない（§9.2）
HASH_KEY=change-me-to-a-different-random-secret-value
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://tapswarm:tapswarm@localhost:5432/tapswarm

# --- 任意（既定値は仕様書 §11 に準拠） ---
BIND_ADDR=0.0.0.0:8080
K_ANONYMITY=3
TOKEN_TTL_DAYS=30
COOLDOWN_SEC=60
MAX_WINDOW_MIN=1440
MAX_LOCATIONS_PER_APP=10000
# レート制限は固定ウィンドウ方式（IP単位）。
#
# scripts/smoke.sh は1回の実行でトークンを7個発行するため、既定の 60 のままだと
# 1時間に8回程度で上限に達する。繰り返し流すときは大きな値にすること。
CLIENT_ISSUE_QUOTA_PER_HOUR=60
CHECKIN_RATE_LIMIT_PER_MIN=300
COLD_RETENTION_DAYS=90
COLD_QUEUE_CAPACITY=10000
COLD_PERSIST_MIN_CHECKINS=10

# クライアントIPの決定方法。
# 0 = TCP のソースアドレスを使う（プロキシなしのローカル実行）
# 1 = X-Forwarded-For の右から1番目を使う（Railway / Render 等、単一プロキシ配下）
# 信頼できるプロキシの段数を正しく設定しないと IP を詐称される（§5.4.3 のレート制限が無力化する）
TRUSTED_PROXY_HOPS=0

RUST_LOG=tapswarm=debug,info
